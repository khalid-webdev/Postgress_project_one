# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Diagnostic reports (next.js / node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string logs
.grunt

# Bower dependency directory (if used)
bower_components

# Node dependencies (Crucial for Node.js)
node_modules/
jspm_packages/

# TypeScript Build Output (Crucial for TypeScript)
# This ignores your compiled JavaScript folder (commonly named 'dist' or 'build')
dist/
build/
out/
tsconfig.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microsoft Office temporary files
~$*

# IDEs and editors
.idea/
.project
.classpath
.cproject
.settings/
*.launch
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.workspace

# Database (Crucial for PostgreSQL local data/dumps)
# Keeps local database exports or data directories out of your repository
*.sql
*.dump
.db_data/
pgdata/

# Environment Variables (Crucial for Security!)
# Never commit your active secrets to GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Keep track of the env template instead
!.env.example

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
